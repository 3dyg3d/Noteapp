app-example

# Native projects are generated by `npx expo prebuild` from app.json.
# Committing them silently breaks continuous native generation: app.json edits
# stop taking effect because prebuild will not overwrite an existing directory
# without --clean. Regenerate instead of committing.
/android
/ios
.expo/
